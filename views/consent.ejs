<!DOCTYPE html>
<html>
<head>
  <title>PDPC Consent</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(140deg, #e2e8f0 0%, #f8fafc 45%, #dbeafe 100%);
      color: #0f172a;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .consent-card {
      width: min(760px, 96vw);
      background: #ffffff;
      border-radius: 16px;
      box-shadow: 0 14px 36px rgba(15, 23, 42, 0.12);
      padding: 30px;
    }

    h1 {
      margin-top: 0;
      margin-bottom: 10px;
      font-size: 2rem;
      color: #0f172a;
    }

    .subtitle {
      color: #475569;
      margin-bottom: 20px;
      line-height: 1.5;
    }

    .notice {
      background: #f8fafc;
      border: 1px solid #dbeafe;
      border-left: 5px solid #2563eb;
      border-radius: 10px;
      padding: 14px 16px;
      margin-bottom: 20px;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 16px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    label {
      font-size: 0.92rem;
      color: #334155;
      font-weight: 600;
    }

    input[type="text"],
    input[type="email"],
    input[type="number"],
    input[type="tel"] {
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 0.96rem;
      color: #0f172a;
      background: #f8fafc;
    }

    .minor-note {
      margin-top: 4px;
      color: #991b1b;
      font-size: 0.88rem;
      font-weight: 600;
    }

    .parental-section {
      border: 1px solid #fecaca;
      border-radius: 10px;
      padding: 12px;
      background: #fff7f7;
      display: none;
    }

    .parental-section.visible {
      display: grid;
      gap: 12px;
    }

    .checkbox-section {
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 12px;
      margin-bottom: 16px;
      background: #ffffff;
    }

    .checkbox-row {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      margin-bottom: 10px;
    }

    .checkbox-row:last-child {
      margin-bottom: 0;
    }

    .checkbox-row input {
      margin-top: 3px;
      transform: scale(1.1);
    }

    .checkbox-row span {
      font-size: 0.95rem;
      line-height: 1.45;
      color: #1e293b;
    }

    .purposes {
      display: grid;
      gap: 8px;
      margin-top: 8px;
    }

    .error {
      margin-bottom: 12px;
      color: #b91c1c;
      font-weight: 700;
      background: #fee2e2;
      border: 1px solid #fecaca;
      border-radius: 8px;
      padding: 10px 12px;
    }

    .meta {
      color: #64748b;
      font-size: 0.9rem;
      margin-bottom: 14px;
    }

    .actions {
      margin-top: 18px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 10px;
      align-items: center;
    }

    .actions a {
      text-decoration: none;
      color: #334155;
      font-weight: 600;
    }

    .actions button {
      border: none;
      background: #2563eb;
      color: #ffffff;
      padding: 12px 18px;
      border-radius: 10px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .actions button:hover {
      background: #1d4ed8;
    }

    @media (max-width: 700px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <main class="consent-card">
    <h1>Consent Form</h1>
    <p class="subtitle">This consent form supports the Personal Data Protection Act (Singapore) consent obligation for collection, use, and disclosure of personal data.</p>

    <div class="notice">
      We collect and process personal data such as identity details, contact details, player profile details, and supporting records to administer MPL Singapore operations.
      You may withdraw consent by contacting the tournament administrator. Withdrawal may affect our ability to continue certain services.
    </div>

    <% if (consentError) { %>
      <div class="error"><%= consentError %></div>
    <% } %>

    <div class="meta">Consent Version: <%= consentVersion %></div>

    <% const form = consentForm || {}; %>

    <form action="/consent" method="POST">
      <input type="hidden" name="returnTo" value="<%= returnTo %>" />

      <div class="grid">
        <div class="field">
          <label for="fullName">Full Name</label>
          <input id="fullName" name="fullName" type="text" placeholder="Your full name" value="<%= form.fullName || '' %>" required />
        </div>
        <div class="field">
          <label for="contactEmail">Contact Email</label>
          <input id="contactEmail" name="contactEmail" type="email" placeholder="name@example.com" value="<%= form.contactEmail || '' %>" required />
        </div>
        <div class="field">
          <label for="age">Age</label>
          <input id="age" name="age" type="number" min="0" max="120" placeholder="Your age" value="<%= form.age || '' %>" required />
          <p class="minor-note">If age is under 18, parental permission and parent details are required.</p>
        </div>

        <div id="parentalSection" class="field full parental-section" aria-live="polite">
          <label class="checkbox-row"><input id="parentalPermission" type="checkbox" name="parentalPermission" value="yes" <%= form.parentalPermission ? 'checked' : '' %> /> <span>I confirm parental/guardian permission has been obtained for this minor.</span></label>
          <div class="field">
            <label for="parentalFullName">Parent/Guardian Full Name</label>
            <input id="parentalFullName" name="parentalFullName" type="text" placeholder="Parent/guardian full name" value="<%= form.parentalFullName || '' %>" />
          </div>
          <div class="field">
            <label for="parentalPhone">Parent/Guardian Phone Number</label>
            <input id="parentalPhone" name="parentalPhone" type="tel" placeholder="Parent/guardian phone number" value="<%= form.parentalPhone || '' %>" />
          </div>
        </div>

        <div class="field full checkbox-section">
          <label>Purpose(s) of processing (select at least one)</label>
          <div class="purposes">
            <label class="checkbox-row"><input type="checkbox" name="consentPurpose" value="player_registration" <%= (form.consentPurpose || []).includes('player_registration') ? 'checked' : '' %> /> <span>Player registration and roster administration.</span></label>
            <label class="checkbox-row"><input type="checkbox" name="consentPurpose" value="identity_verification" <%= (form.consentPurpose || []).includes('identity_verification') ? 'checked' : '' %> /> <span>Identity and eligibility verification for league participation.</span></label>
            <label class="checkbox-row"><input type="checkbox" name="consentPurpose" value="competition_operations" <%= (form.consentPurpose || []).includes('competition_operations') ? 'checked' : '' %> /> <span>Competition operations, scheduling, and team coordination.</span></label>
          </div>
        </div>

        <div class="field full checkbox-section">
          <label>Required acknowledgements</label>
          <label class="checkbox-row"><input type="checkbox" name="acknowledgeNotice" value="yes" <%= form.acknowledgeNotice ? 'checked' : '' %> /> <span>I have read and understood the data collection and use notice.</span></label>
          <label class="checkbox-row"><input type="checkbox" name="consentCollectionUse" value="yes" <%= form.consentCollectionUse ? 'checked' : '' %> /> <span>I consent to the collection and use of my personal data for the selected purpose(s).</span></label>
          <label class="checkbox-row"><input type="checkbox" name="consentDisclosure" value="yes" <%= form.consentDisclosure ? 'checked' : '' %> /> <span>I consent to disclosure of relevant personal data to authorized league staff and administrators when required for operations.</span></label>
          <label class="checkbox-row"><input type="checkbox" name="confirmAge" value="yes" <%= form.confirmAge ? 'checked' : '' %> /> <span>I confirm I am authorized to provide this consent.</span></label>
        </div>
      </div>

      <div class="actions">
        <a href="<%= returnTo %>">Cancel</a>
        <button type="submit">Submit Consent</button>
      </div>
    </form>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const ageInput = document.getElementById('age');
      const parentalSection = document.getElementById('parentalSection');
      const parentalPermission = document.getElementById('parentalPermission');
      const parentalFullName = document.getElementById('parentalFullName');
      const parentalPhone = document.getElementById('parentalPhone');

      function updateParentalRequirement() {
        const age = parseInt(ageInput.value, 10);
        const isMinor = Number.isInteger(age) && age < 18;

        if (isMinor) {
          parentalSection.classList.add('visible');
          parentalPermission.required = true;
          parentalFullName.required = true;
          parentalPhone.required = true;
        } else {
          parentalSection.classList.remove('visible');
          parentalPermission.required = false;
          parentalFullName.required = false;
          parentalPhone.required = false;
          parentalPermission.checked = false;
          parentalFullName.value = '';
          parentalPhone.value = '';
        }
      }

      ageInput.addEventListener('input', updateParentalRequirement);
      updateParentalRequirement();
    });
  </script>
</body>
</html>
