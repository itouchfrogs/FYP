<!DOCTYPE html>
<html>
<head>
  <title>Login Options</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f3f4f6;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      color: #111827;
    }

    .page-card {
      background: white;
      border-radius: 16px;
      padding: 36px;
      box-shadow: 0 14px 45px rgba(17, 24, 39, 0.12);
      width: min(520px, 96vw);
      text-align: center;
    }

    .page-card h1 {
      margin-top: 0;
      margin-bottom: 18px;
      font-size: 2rem;
    }

    .page-card p {
      color: #6b7280;
      margin-bottom: 28px;
    }

    .button-group {
      display: grid;
      gap: 14px;
    }

    .button-group a {
      display: block;
      padding: 14px 18px;
      text-decoration: none;
      border-radius: 10px;
      background: #2563eb;
      color: white;
      font-weight: 600;
      transition: background 0.2s ease;
    }

    .button-group a:hover {
      background: #1d4ed8;
    }

    .button-group a.secondary {
      background: #64748b;
    }

    .button-group a.secondary:hover {
      background: #475569;
    }
  </style>
</head>
<body>
  <div class="page-card">
    <h1>Login Options</h1>
    <p>Select the login flow that matches your role.</p>
    <div class="button-group">
      <a href="/playerlogin">Player Login</a>
      <a href="/employeelogin">Employee Login</a>
      <a href="/login" class="secondary">Admin Login</a>
      <a href="/" class="secondary">Back to Home</a>
    </div>
  </div>
</body>
</html>
