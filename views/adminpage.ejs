<!DOCTYPE html>
<html>
<head>
  <title>Admin Dashboard</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f3f4f6;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      color: #111827;
    }

    .dashboard-card {
      background: white;
      border-radius: 16px;
      padding: 40px;
      width: min(520px, 96vw);
      box-shadow: 0 14px 45px rgba(17, 24, 39, 0.12);
      text-align: center;
    }

    .dashboard-card h1 {
      margin-top: 0;
      margin-bottom: 12px;
      font-size: 2rem;
    }

    .dashboard-card .subtitle {
      color: #6b7280;
      margin-bottom: 32px;
      font-size: 1rem;
    }

    .button-group {
      display: grid;
      gap: 14px;
      margin-bottom: 28px;
    }

    .button-group a,
    .dropdown-content a {
      display: block;
      padding: 16px 20px;
      text-decoration: none;
      border-radius: 12px;
      background: #2563eb;
      color: white;
      font-weight: 600;
      font-size: 1.05rem;
      transition: background 0.2s ease;
    }

    .button-group a:hover,
    .dropdown-content a:hover {
      background: #1d4ed8;
    }

    .button-group a.logout {
      background: #ef4444;
    }

    .button-group a.logout:hover {
      background: #dc2626;
    }

    .dropdown {
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      overflow: hidden;
    }

    .dropdown summary {
      list-style: none;
      cursor: pointer;
      padding: 16px 20px;
      background: #e5edff;
      color: #1e3a8a;
      font-weight: 700;
      user-select: none;
      position: relative;
    }

    .dropdown summary::-webkit-details-marker {
      display: none;
    }

    .dropdown summary::after {
      content: '+';
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.1rem;
      font-weight: 700;
    }

    .dropdown[open] summary::after {
      content: '-';
    }

    .dropdown-content {
      padding: 12px;
      display: grid;
      gap: 10px;
      background: #ffffff;
    }
  </style>
</head>
<body>
  <div class="dashboard-card">
    <h1>Admin Dashboard</h1>
    <p class="subtitle">Use the sections below to manage players, teams, and admin access.</p>
    <div class="button-group">
      <a href="/">Home</a>

      <details class="dropdown" open>
        <summary>Player Management</summary>
        <div class="dropdown-content">
          <a href="/playerinfo">View Full Player Info</a>
          <a href="/players/add">Add Player</a>
        </div>
      </details>

      <details class="dropdown">
        <summary>Team Management</summary>
        <div class="dropdown-content">
          <a href="/teams">View Teams</a>
          <a href="/teams/add">Add Team</a>
        </div>
      </details>

      <details class="dropdown">
        <summary>Admin Management</summary>
        <div class="dropdown-content">
          <a href="/admins" class="admin">Account Mangement</a>
          <a href="/admins/add" class="admin">Create New Admin/Employee Account</a>
          <a href="/consent-records" class="admin">View Consent Records</a>
        </div>
      </details>

      <a href="/logout" class="logout">Logout</a>
    </div>
  </div>
</body>
</html>