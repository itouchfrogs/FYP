<!DOCTYPE html>
<html>
<head>
    <title>Teams</title>
</head>
<body>
    <h1>All Teams</h1>

    <p>
        <a href="/">Back</a> |
        <a href="/players/add">Add Player</a> |
        <a href="/teams/add">Add New Team</a> |
    </p>

    <% if (teams.length === 0) { %>
        <p>No teams found.</p>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th>Team Name</th>
                </tr>
            </thead>
            <tbody>
                <% teams.forEach(team => { %>
                    <tr>
                        <td><%= team.teamName %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</body>
</html>