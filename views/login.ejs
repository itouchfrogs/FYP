<!DOCTYPE html>
<html>
<head>
  <title>Admin Login</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f3f4f6;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      color: #111827;
    }

    .login-card {
      background: white;
      border-radius: 12px;
      padding: 32px;
      box-shadow: 0 14px 45px rgba(17, 24, 39, 0.12);
      width: min(420px, 90vw);
    }

    .login-card h1 {
      margin-top: 0;
      margin-bottom: 24px;
      font-size: 1.75rem;
    }

    .login-card label {
      display: block;
      margin-bottom: 8px;
      font-weight: 600;
    }

    .login-card input {
      width: 100%;
      padding: 12px 14px;
      margin-bottom: 18px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 1rem;
      box-sizing: border-box;
    }

    .login-card button {
      width: 100%;
      padding: 12px 16px;
      border: none;
      border-radius: 8px;
      background: #2563eb;
      color: white;
      font-size: 1rem;
      cursor: pointer;
    }

    .login-card button:hover {
      background: #1d4ed8;
    }

    .login-card .note {
      margin-top: 18px;
      color: #6b7280;
      font-size: 0.95rem;
    }
  </style>
</head>
<body>
  <div class="login-card">
    <h1>Admin Login</h1>
    <form action="/login" method="POST">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" placeholder="Username" required>

      <label for="password">Password</label>
      <input type="password" id="password" name="password" placeholder="Password" required>

      <button type="submit">Login</button>
    </form>
    <p class="note">Use your admin credentials to access the dashboard.</p>
  </div>
</body>
</html>
