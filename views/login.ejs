<!DOCTYPE html>
<html>
<head>
  <title><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Admin Login' %></title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f3f4f6;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      color: #111827;
    }

    .login-card {
      background: white;
      border-radius: 12px;
      padding: 32px;
      box-shadow: 0 14px 45px rgba(17, 24, 39, 0.12);
      width: min(420px, 90vw);
    }

    .login-card h1 {
      margin-top: 0;
      margin-bottom: 24px;
      font-size: 1.75rem;
    }

    .login-card label {
      display: block;
      margin-bottom: 8px;
      font-weight: 600;
    }

    .login-card input {
      width: 100%;
      padding: 12px 14px;
      margin-bottom: 18px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 1rem;
      box-sizing: border-box;
    }

    .login-card button {
      width: 100%;
      padding: 12px 16px;
      border: none;
      border-radius: 8px;
      background: #2563eb;
      color: white;
      font-size: 1rem;
      cursor: pointer;
    }

    .login-card button:hover {
      background: #1d4ed8;
    }

    .login-card .note {
      margin-top: 18px;
      color: #6b7280;
      font-size: 0.95rem;
    }

    .login-card .message {
      margin-bottom: 16px;
      padding: 10px 12px;
      border-radius: 8px;
      background: #fef2f2;
      color: #b91c1c;
      font-size: 0.95rem;
    }
  </style>
</head>
<body>
  <% const lockoutActive = Number(remainingTime || 0) > 0; %>
  <div class="login-card">
    <h1><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Admin Login' %></h1>
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="message"><%= errorMessage %></div>
    <% } %>
    <form action="/login" method="POST">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" placeholder="Username" required>

      <label for="password">Password</label>
      <input type="password" id="password" name="password" placeholder="Password" required>
      <p id="lockoutTimer" class="note"></p>
      <p class="note">Use your admin or employee credentials to access the dashboard.</p>
      <button id="loginButton" type="submit" data-lockout-active="<%= lockoutActive ? 'true' : 'false' %>" data-remaining-time="<%= Number(remainingTime || 0) %>">
        Login
      </button>
    </form>
  </div>
  <script>
    const loginButton = document.getElementById("loginButton");
    let remainingTime = Number(loginButton?.dataset.remainingTime || 0);
    const lockoutActive = loginButton?.dataset.lockoutActive === 'true';

    const timerElement = document.getElementById("lockoutTimer");

    function updateTimer() {
      if (remainingTime <= 0) {
        if (timerElement) {
          timerElement.innerHTML = "";
        }
        if (loginButton) {
          loginButton.disabled = false;
        }
        return;
      }

      if (loginButton) {
        loginButton.disabled = true;
      }

      const minutes = Math.floor(remainingTime / 60);
      const seconds = remainingTime % 60;

      if (timerElement) {
        timerElement.innerHTML = `Too many failed attempts. Try again in ${minutes}m ${seconds}s`;
      }

      remainingTime -= 1;
      setTimeout(updateTimer, 1000);
    }

    if (lockoutActive) {
      updateTimer();
    }
  </script>
</body>
</html>
