<!DOCTYPE html>
<html>
<head>
    <title>Retrieve Original Address</title>
</head>
<body>
    <h1>Retrieve Original Address from Token</h1>
    
    <% if (success && realAddress) { %>
        <div style="background-color: #d4edda; padding: 15px; margin: 20px 0; border-radius: 5px;">
            <h2>Address Found!</h2>
            <p><strong>Token:</strong> <%= token %></p>
            <p><strong>Original Address:</strong></p>
            <p style="background-color: #fff; padding: 10px; border: 1px solid #c3e6cb; border-radius: 3px;">
                <%= realAddress %>
            </p>
        </div>
    <% } else if (success === false) { %>
        <div style="margin: 20px 0; padding: 15px; background-color: #fff3cd; border-radius: 5px;">
            <strong>Enter a token above to retrieve the original address.</strong>
        </div>
    <% } %>
    
    <form action="/address-vault/retrieve" method="POST" style="max-width: 500px;">
        <div style="margin-bottom: 15px;">
            <label for="token" style="font-weight: bold;">Address Token:</label>
            <input 
                type="text" 
                id="token" 
                name="token" 
                required
                style="width: 100%; padding: 10px; font-size: 16px; border: 1px solid #ccc; border-radius: 4px;"
                placeholder="Enter the token (e.g., aB3xK9mN2pQ7rT4s)"
                value="<%= token || '' %>"
            >
        </div>
        
        <div style="margin-bottom: 15px;">
            <button 
                type="submit" 
                style="padding: 12px 24px; font-size: 16px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;"
            >
                Retrieve Address
            </button>
        </div>
    </form>
    
    <div style="margin: 20px 0; padding: 15px; background-color: #f8d7da; border-radius: 5px;">
        <strong>Note:</strong> The token is stored in the player's <code>address</code> field (which is actually the token). 
        Use that token to retrieve the real address from the vault.
    </div>
    
    <hr style="margin: 30px 0;">
    
    <h2>Quick Reference</h2>
    <p><strong>To find a player's address token:</strong></p>
    <ol>
        <li>Go to <a href="/players">Players List</a></li>
        <li>Find the player you want</li>
        <li>The <code>address</code> field contains the token</li>
        <li>Enter that token above to retrieve the original address</li>
    </ol>
    
    <p><a href="/adminpage">Back to Admin Page</a></p>
    <p><a href="/players">View All Players</a></p>
</body>
</html>