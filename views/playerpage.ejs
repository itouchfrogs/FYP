<!DOCTYPE html>
<html>
<head>
  <title>Player Dashboard</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f3f4f6;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      color: #111827;
    }

    .dashboard-card {
      background: white;
      border-radius: 16px;
      padding: 40px;
      width: min(520px, 96vw);
      box-shadow: 0 14px 45px rgba(17, 24, 39, 0.12);
      text-align: center;
    }

    .dashboard-card h1 {
      margin-top: 0;
      margin-bottom: 12px;
      font-size: 2rem;
    }

    .dashboard-card .greeting {
      color: #6b7280;
      margin-bottom: 32px;
      font-size: 1.05rem;
    }

    .button-group {
      display: grid;
      gap: 14px;
      margin-bottom: 28px;
    }

    .button-group a {
      display: block;
      padding: 16px 20px;
      text-decoration: none;
      border-radius: 12px;
      background: #2563eb;
      color: white;
      font-weight: 600;
      font-size: 1.05rem;
      transition: background 0.2s ease;
    }

    .button-group a:hover {
      background: #1d4ed8;
    }

    .button-group a.secondary {
      background: #64748b;
    }

    .button-group a.secondary:hover {
      background: #475569;
    }

    .footer-links {
      border-top: 1px solid #e2e8f0;
      padding-top: 18px;
      margin-top: 28px;
    }

    .footer-links a {
      text-decoration: none;
      color: #2563eb;
      font-weight: 600;
      margin: 0 12px;
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: #1d4ed8;
    }
  </style>
</head>
<body>
  <div class="dashboard-card">
    <h1>Welcome</h1>
    <p class="greeting">Choose what you'd like to do:</p>
    <div class="button-group">
      <a href="/playerprofile">View My Profile</a>
      <a href="/players">View All Players</a>
    </div>
    <div class="footer-links">
      <a href="/">Home</a>
      <a href="/logout">Logout</a>
    </div>
  </div>
</body>
</html>
