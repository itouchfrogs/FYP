<!DOCTYPE html>
<html>
<head>
  <title>Employee Login</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f3f4f6;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      color: #111827;
    }

    .login-card {
      background: white;
      border-radius: 12px;
      padding: 32px;
      box-shadow: 0 14px 45px rgba(17, 24, 39, 0.12);
      width: min(420px, 90vw);
    }

    .login-card h1 {
      margin-top: 0;
      margin-bottom: 24px;
      font-size: 1.75rem;
    }

    .login-card label {
      display: block;
      margin-bottom: 8px;
      font-weight: 600;
    }

    .login-card input {
      width: 100%;
      padding: 12px 14px;
      margin-bottom: 18px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 1rem;
      box-sizing: border-box;
    }

    .login-card button {
      width: 100%;
      padding: 12px 16px;
      border: none;
      border-radius: 8px;
      background: #059669;
      color: white;
      font-size: 1rem;
      cursor: pointer;
    }

    .login-card button:hover {
      background: #047857;
    }

    .login-card .note {
      margin-top: 18px;
      color: #6b7280;
      font-size: 0.95rem;
    }

    .login-card .error {
      background: #fee2e2;
      color: #b91c1c;
      border-radius: 8px;
      padding: 10px 14px;
      margin-bottom: 16px;
      font-size: 0.95rem;
    }

    .login-card .timer {
      background: #fef3c7;
      color: #92400e;
      border-radius: 8px;
      padding: 10px 14px;
      margin-bottom: 16px;
      font-size: 0.95rem;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <div class="login-card">
    <h1>Employee Login</h1>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <% if (typeof remainingTime !== 'undefined' && remainingTime > 0) { %>
      <div class="timer" id="lockoutTimer" data-seconds="<%= remainingTime %>">
        Try again in <strong id="timerValue"><%= remainingTime %></strong> seconds.
      </div>
    <% } %>
    <form action="/employeelogin" method="POST">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" placeholder="Name" required>

      <label for="password">Password</label>
      <input type="password" id="password" name="password" placeholder="Password" required>

      <button type="submit">Login</button>
    </form>
    <p class="note">Use your employee credentials to access the dashboard.</p>
  </div>

  <script>
    const timerElement = document.getElementById('lockoutTimer');
    const timerValue = document.getElementById('timerValue');

    if (timerElement && timerValue) {
      let remainingSeconds = Number(timerElement.dataset.seconds || 0);

      const updateTimer = () => {
        if (remainingSeconds <= 0) {
          timerElement.style.display = 'none';
          return;
        }

        const minutes = Math.floor(remainingSeconds / 60);
        const seconds = remainingSeconds % 60;
        timerValue.textContent = `${minutes}m ${seconds}s`;
        remainingSeconds -= 1;
      };

      updateTimer();
      setInterval(updateTimer, 1000);
    }
  </script>
</body>
</html>
