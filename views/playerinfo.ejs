<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Player Info</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #f3f4f6;
            color: #111827;
        }

        .navbar {
            background: #111827;
            color: #f9fafb;
            padding: 16px 24px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .navbar .brand {
            font-size: 1.25rem;
            font-weight: 700;
        }

        .navbar nav {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
        }

        .navbar a {
            color: #f9fafb;
            text-decoration: none;
            padding: 8px 12px;
            border-radius: 6px;
            transition: background 0.2s ease;
        }

        .navbar a:hover {
            background: rgba(255, 255, 255, 0.12);
        }

        .navbar a.active {
            background: #2563eb;
        }

        .page-content {
            max-width: 1400px;
            margin: 28px auto;
            padding: 0 20px;
        }

        .page-title {
            margin-top: 0;
            margin-bottom: 12px;
            font-size: 2rem;
        }

        .page-subtitle {
            margin-top: 0;
            color: #6b7280;
            margin-bottom: 18px;
        }

        .table-wrap {
            overflow-x: auto;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1600px;
        }

        th,
        td {
            padding: 12px 10px;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
            vertical-align: top;
            white-space: nowrap;
            font-size: 0.95rem;
        }

        th {
            background: #f9fafb;
            color: #111827;
            font-weight: 700;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        tr:hover td {
            background: #f8fafc;
        }

        .team-row td {
            background: #e0e7ff;
            color: #1e3a8a;
            font-weight: 700;
            border-top: 2px solid #c7d2fe;
            border-bottom: 1px solid #c7d2fe;
        }

        .empty {
            padding: 24px;
            color: #6b7280;
        }

        .delete-btn {
            background: #ef4444;
            color: #ffffff;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: background 0.2s ease;
        }

        .delete-btn:hover {
            background: #dc2626;
        }

        .delete-form {
            margin: 0;
        }
    </style>
</head>
<body>
    <header class="navbar">
        <div class="brand">MPL Singapore</div>
        <nav>
            <a href="/">Home</a>
            <a href="/adminpage">Admin Dashboard</a>
            <a href="/players">Players</a>
            <a href="/playerinfo" class="active">Player Info</a>
            <a href="/logout">Logout</a>
        </nav>
    </header>

    <main class="page-content">
        <h1 class="page-title">Player Information</h1>
        <p class="page-subtitle">Admin-only, unanonymized player data. Total players: <%= players.length %></p>
        <div class="table-wrap">
            <% if (players.length === 0) { %>
                <div class="empty">No player records found.</div>
            <% } else { %>
                <% const formatDateOnly = (value) => {
                    if (!value) return '';
                    if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value)) {
                        return value;
                    }

                    const parsedDate = new Date(value);
                    if (!Number.isNaN(parsedDate.getTime())) {
                        const year = parsedDate.getFullYear();
                        const month = String(parsedDate.getMonth() + 1).padStart(2, '0');
                        const day = String(parsedDate.getDate()).padStart(2, '0');
                        return `${year}-${month}-${day}`;
                    }

                    return String(value).split(' GMT')[0];
                }; %>
                <% const sortedPlayers = [...players].sort((a, b) => {
                    const teamA = (a.teamName || 'Unassigned').toLowerCase();
                    const teamB = (b.teamName || 'Unassigned').toLowerCase();
                    if (teamA !== teamB) return teamA.localeCompare(teamB);

                    const nameA = (a.name || '').toLowerCase();
                    const nameB = (b.name || '').toLowerCase();
                    return nameA.localeCompare(nameB);
                }); %>
                <% const playersByTeam = sortedPlayers.reduce((groups, player) => {
                    const teamName = player.teamName || 'Unassigned';
                    if (!groups[teamName]) groups[teamName] = [];
                    groups[teamName].push(player);
                    return groups;
                }, {}); %>
                <table>
                    <thead>
                        <tr>
                            <th>ic</th>
                            <th>name</th>
                            <th>age</th>
                            <th>dateOfBirth</th>
                            <th>phoneNumber</th>
                            <th>email</th>
                            <th>username</th>
                            <th>accountId</th>
                            <th>serverId (original)</th>
                            <th>addressToken</th>
                            <th>realAddress</th>
                            <th>postalCode</th>
                            <th>region</th>
                            <th>swappedRegion</th>
                            <th>country</th>
                            <th>teamName</th>
                            <th>role</th>
                            <th>password (stored hash/plain)</th>
                            <th>actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% Object.entries(playersByTeam).forEach(([teamName, teamPlayers]) => { %>
                            <tr class="team-row">
                                <td colspan="19"><%= teamName %></td>
                            </tr>
                            <% teamPlayers.forEach((player) => { %>
                                <tr>
                                    <td><%= player.ic ?? '' %></td>
                                    <td><%= player.name ?? '' %></td>
                                    <td><%= player.age ?? '' %></td>
                                    <td><%= formatDateOnly(player.originalDob ?? player.dateOfBirth) %></td>
                                    <td><%= player.phoneNumber ?? '' %></td>
                                    <td><%= player.email ?? '' %></td>
                                    <td><%= player.username ?? '' %></td>
                                    <td><%= player.accountId ?? '' %></td>
                                    <td><%= player.originalServerId ?? player.serverId ?? '' %></td>
                                    <td><%= player.address ?? '' %></td>
                                    <td><%= player.realAddress ?? '' %></td>
                                    <td><%= player.postalCode ?? '' %></td>
                                    <td><%= player.region ?? '' %></td>
                                    <td><%= player.swappedRegion ?? '' %></td>
                                    <td><%= player.country ?? '' %></td>
                                    <td><%= player.teamName ?? '' %></td>
                                    <td><%= player.role ?? '' %></td>
                                    <td><%= player.password ?? '' %></td>
                                    <td>
                                        <form class="delete-form" action="/players/delete/<%= player.playerId %>" method="POST" onsubmit="return confirm('Delete this player?');">
                                            <button class="delete-btn" type="submit">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </main>
</body>
</html>