<!DOCTYPE html>
<html>
<head>
    <title>All Players</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background: #f3f4f6;
        color: #111827;
      }

      .navbar {
        background: #111827;
        color: #f9fafb;
        padding: 16px 24px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .navbar .brand {
        font-size: 1.25rem;
        font-weight: 700;
      }

      .navbar nav {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
      }

      .navbar a {
        color: #f9fafb;
        text-decoration: none;
        padding: 8px 12px;
        border-radius: 6px;
        transition: background 0.2s ease;
      }

      .navbar a:hover {
        background: rgba(255, 255, 255, 0.12);
      }

      .navbar a.active {
        background: #2563eb;
      }

      .dropdown {
        position: relative;
        display: inline-block;
      }

      .dropdown-btn {
        color: #f9fafb;
        padding: 8px 12px;
        border: none;
        background-color: transparent;
        cursor: pointer;
        border-radius: 6px;
        transition: background 0.2s ease;
        font-size: 1rem;
        font-family: Arial, sans-serif;
      }

      .dropdown-btn:hover {
        background: rgba(255, 255, 255, 0.12);
      }

      .dropdown-content {
        display: none;
        position: absolute;
        background-color: #1f2937;
        min-width: 200px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        padding: 12px 0;
        z-index: 1;
        border-radius: 6px;
        top: 100%;
        margin-top: 4px;
      }

      .dropdown-content a {
        color: #f9fafb;
        padding: 12px 16px;
        text-decoration: none;
        display: block;
        transition: background 0.2s ease;
      }

      .dropdown-content a:hover {
        background-color: #374151;
      }

      .dropdown-content.active {
        display: block;
      }

      .page-content {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 24px;
      }

      .page-title {
        margin-top: 0;
        font-size: 2rem;
        margin-bottom: 24px;
      }

      .player-list {
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
        padding: 24px;
      }

      .player-card {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 16px;
        background: #f9fafb;
        transition: box-shadow 0.2s ease;
      }

      .player-card:hover {
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
      }

      .player-card h3 {
        margin-top: 0;
        color: #1f2937;
        font-size: 1.25rem;
      }

      .player-card p {
        margin: 8px 0;
        color: #4b5563;
      }

      .player-card strong {
        color: #111827;
      }

      .player-card button {
        background: #ef4444;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.2s ease;
        font-size: 0.9rem;
        margin-top: 12px;
      }

      .player-card button:hover {
        background: #dc2626;
      }

      .no-players {
        text-align: center;
        color: #6b7280;
        padding: 40px 0;
        font-size: 1.1rem;
      }
    </style>
</head>
<body>
  <header class="navbar">
    <div class="brand">MPL Singapore</div>
    <nav>
      <a href="/">Home</a>
      <a href="/players" class="active">Players</a>
      
      <div class="dropdown">
        <button class="dropdown-btn">Dashboards ▼</button>
        <div class="dropdown-content">
          <a href="/playerpage">Player Dashboard</a>
          <a href="/adminpage">Admin Dashboard</a>
        </div>
      </div>
      
      <a href="/loginlist">Login Options</a>
    </nav>
  </header>

  <main class="page-content">
    <h1 class="page-title">All Players</h1>
    
    <div class="player-list">
      <% if (players.length === 0) { %>
        <p class="no-players">No players found.</p>
      <% } else { %>
        <% players.forEach(player => { %>
          <div class="player-card">
            <h3><%= player.name %></h3>
            <p><strong>Age:</strong> <%= player.age %></p>
            <p><strong>Age:</strong> <%= player.ageRange %></p>
              <strong>Email:</strong>
              <%
                const email = player.email || '';
                const at = email.indexOf('@');
                let maskedEmail = email;
                if (at > 0) {
                  const name = email.slice(0, at);
                  const domain = email.slice(at);
                  maskedEmail = name[0] + '*****' + domain;
                }
              %>
              <%= maskedEmail %>
            </p>
            <p><strong>Username:</strong> <%= player.username %></p>
            <p><strong>Team:</strong> <%= player.teamName %></p>
            <p><strong>Role:</strong> <%= player.role %></p>
            <p><strong>Region:</strong> <%= player.region %></p>
            <p><strong>SwappedRegion:</strong> <%= player.swappedRegion || 'N/A' %></p>
            <p><strong>ServerId:</strong> <%= player.serverId || 'N/A' %></p>
            <form action="/players/delete/<%= player.playerId %>" method="POST">
              <button type="submit">Delete Player</button>
            </form>
          </div>
        <% }) %>
      <% } %>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const dropdownBtn = document.querySelector('.dropdown-btn');
      const dropdownContent = document.querySelector('.dropdown-content');

      // Toggle dropdown on button click
      dropdownBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        dropdownContent.classList.toggle('active');
      });

      // Close dropdown when clicking on a link inside it
      const dropdownLinks = document.querySelectorAll('.dropdown-content a');
      dropdownLinks.forEach(link => {
        link.addEventListener('click', function() {
          dropdownContent.classList.remove('active');
        });
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', function(e) {
        if (!e.target.closest('.dropdown')) {
          dropdownContent.classList.remove('active');
        }
      });
    });
  </script>
</body>
</html>
