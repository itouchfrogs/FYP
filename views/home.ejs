<!DOCTYPE html>
<html>
<head>
  <title>MPL Singapore</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background: #f3f4f6;
      color: #111827;
    }

    .navbar {
      background: #111827;
      color: #f9fafb;
      padding: 16px 24px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .navbar .brand {
      font-size: 1.25rem;
      font-weight: 700;
    }

    .navbar nav {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }

    .navbar a {
      color: #f9fafb;
      text-decoration: none;
      padding: 8px 12px;
      border-radius: 6px;
      transition: background 0.2s ease;
    }

    .navbar a:hover {
      background: rgba(255, 255, 255, 0.12);
    }

    .navbar a.active {
      background: #2563eb;
    }

    .dropdown {
      position: relative;
      display: inline-block;
    }

    .dropdown-btn {
      color: #f9fafb;
      padding: 8px 12px;
      border: none;
      background-color: transparent;
      cursor: pointer;
      border-radius: 6px;
      transition: background 0.2s ease;
      font-size: 1rem;
      font-family: Arial, sans-serif;
    }

    .dropdown-btn:hover {
      background: rgba(255, 255, 255, 0.12);
    }

    .dropdown-content {
      display: none;
      position: absolute;
      background-color: #1f2937;
      min-width: 200px;
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
      padding: 12px 0;
      z-index: 1;
      border-radius: 6px;
      top: 100%;
      margin-top: 4px;
    }

    .dropdown-content a {
      color: #f9fafb;
      padding: 12px 16px;
      text-decoration: none;
      display: block;
      transition: background 0.2s ease;
    }

    .dropdown-content a:hover {
      background-color: #374151;
    }

    .dropdown-content.active {
      display: block;
    }

    .page-content {
      max-width: 900px;
      margin: 40px auto;
      padding: 0 24px;
    }

    .page-title {
      margin-top: 0;
      font-size: 2rem;
    }

    .hero {
      background: #ffffff;
      border-radius: 14px;
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
      padding: 32px;
      text-align: center;
    }

    .hero-logo {
      width: 100%;
      max-width: 240px;
      height: auto;
      display: block;
      margin: 0 auto 20px;
    }

    .teams-section {
      background: #ffffff;
      border-radius: 14px;
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
      padding: 28px;
      margin-top: 24px;
    }

    .teams-title {
      margin: 0 0 16px;
      font-size: 1.5rem;
    }

    .teams-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
    }

    .teams-list li {
      background: #f8fafc;
      border: 1px solid #d1d5db;
      border-radius: 10px;
      padding: 12px 14px;
      font-weight: 600;
      color: #1f2937;
    }

  </style>
</head>
<body>
  <header class="navbar">
    <div class="brand">MPL Singapore</div>
    <nav>
      <a href="/" class="active">Home</a>
      <a href="/players">Players</a>
      
        <div class="dropdown">
        <button class="dropdown-btn">Dashboards ▼</button>
        <div class="dropdown-content">
          <a href="/playerpage">Player Dashboard</a>
          <a href="/adminpage">Admin Dashboard</a>
          <a href="/employeepage">Employee Dashboard</a>
        </div>
      </div>
      
      <a href="/loginlist">Login Options</a>
    </nav>
  </header>

  <main class="page-content">
    <section class="hero">
      <img class="hero-logo" src="/images/MPL%20logo.png" alt="MPL Singapore logo">
      <h1 class="page-title">MLBB Professional League Singapore</h1>
      <p>Welcome to MPL Singapore. Use the navigation above to view players, add new players, manage teams, or sign in.</p>
    </section>

    <section class="teams-section">
      <h2 class="teams-title">Participating Teams</h2>
      <ul class="teams-list">
        <% (typeof teams !== 'undefined' ? teams : []).forEach(team => { %>
          <li><%= team.teamName %></li>
        <% }) %>
      </ul>
    </section>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const dropdownBtn = document.querySelector('.dropdown-btn');
      const dropdownContent = document.querySelector('.dropdown-content');

      // Toggle dropdown on button click
      dropdownBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        dropdownContent.classList.toggle('active');
      });

      // Close dropdown when clicking on a link inside it
      const dropdownLinks = document.querySelectorAll('.dropdown-content a');
      dropdownLinks.forEach(link => {
        link.addEventListener('click', function() {
          dropdownContent.classList.remove('active');
        });
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', function(e) {
        if (!e.target.closest('.dropdown')) {
          dropdownContent.classList.remove('active');
        }
      });
    });
  </script>
</body>
</html>
