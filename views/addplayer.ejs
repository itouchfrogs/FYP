        </div>
        <div>
          <label for="email">Email</label>
          <input id="email" name="email" type="email" placeholder="Email" required />
        </div>
        <div>
          <label for="username">In-game Name</label>
          <input id="username" name="username" type="text" placeholder="In-game name" required />
        </div>
        <div>
          <label for="accountId">Game ID</label>
          <input id="accountId" name="accountId" type="text" placeholder="Game ID" required />
        </div>
        <div>
          <label for="serverId">Server ID</label>
          <input id="serverId" name="serverId" type="text" placeholder="Server ID" required />
        </div>
        <div class="full-width">
          <label for="address">Address</label>
          <textarea id="address" name="address" placeholder="Address" required></textarea>
        </div>
        <div>
