<!DOCTYPE html>
<html>
<head>
  <title>Add Player</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f3f4f6;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      color: #111827;
    }

    .form-card {
      background: white;
      border-radius: 16px;
      padding: 32px;
      width: min(760px, 96vw);
      box-shadow: 0 14px 45px rgba(17, 24, 39, 0.12);
    }

    .form-card h1 {
      margin-top: 0;
      margin-bottom: 24px;
      font-size: 2rem;
    }

    .form-grid {
      display: grid;
      gap: 16px;
      grid-template-columns: repeat(2, minmax(240px, 1fr));
    }

    .form-grid textarea {
      min-height: 120px;
      resize: vertical;
    }

    label {
      display: block;
      margin-bottom: 8px;
      color: #475569;
      font-size: 0.95rem;
    }

    input,
    select,
    textarea {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #d1d5db;
      border-radius: 10px;
      font-size: 1rem;
      background: #f8fafc;
      color: #111827;
      box-sizing: border-box;
    }

    .full-width {
      grid-column: 1 / -1;
    }

    .button-row {
      margin-top: 24px;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: flex-end;
    }

    .button-row button,
    .button-row a {
      padding: 14px 22px;
      border-radius: 10px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      text-decoration: none;
      color: white;
      background: #2563eb;
      transition: background 0.2s ease;
    }

    .button-row a {
      background: #64748b;
    }

    .button-row button:hover {
      background: #1d4ed8;
    }

    .button-row a:hover {
      background: #475569;
    }
  </style>
</head>
<body>
  <div class="form-card">
    <h1>Add New Player</h1>
    <form action="/players/add" method="POST">
      <div class="form-grid">
        <div>
          <label for="name">Name</label>
          <input id="name" name="name" type="text" placeholder="Name" required />
        </div>
        <div>
          <label for="age">Age</label>
          <input id="age" name="age" type="number" placeholder="Age" required />
        </div>
        <div>
