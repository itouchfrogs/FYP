<!DOCTYPE html>
<html>
<head>
  <title>Edit Player Profile</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f3f4f6;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      color: #111827;
    }

    .edit-card {
      background: white;
      border-radius: 16px;
      padding: 32px;
      width: min(720px, 96vw);
      box-shadow: 0 14px 45px rgba(17, 24, 39, 0.12);
    }

    h1 {
      margin-top: 0;
      margin-bottom: 24px;
      font-size: 2rem;
    }

    .form-grid {
      display: grid;
      gap: 16px;
      grid-template-columns: repeat(2, minmax(220px, 1fr));
    }

    label {
      display: block;
      font-size: 0.95rem;
      margin-bottom: 6px;
      color: #475569;
    }

    input,
    select {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #d1d5db;
      border-radius: 10px;
      font-size: 1rem;
      background: #f8fafc;
      color: #111827;
    }

    .full-width {
      grid-column: 1 / -1;
    }

    .button-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: flex-end;
      margin-top: 24px;
    }

    .button-row button,
    .button-row a {
      padding: 14px 20px;
      border-radius: 10px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      text-decoration: none;
    }

    .button-row button {
      background: #2563eb;
      color: white;
    }

    .button-row a {
      background: #e2e8f0;
      color: #475569;
    }

    .button-row button:hover {
      background: #1d4ed8;
    }

    .button-row a:hover {
      background: #cbd5e1;
    }
  </style>
</head>
<body>
  <div class="edit-card">
    <h1>Edit Player Information</h1>
    <form action="/playerprofile/edit" method="POST">
      <% const teamList = (typeof teams !== 'undefined' && Array.isArray(teams)) ? teams : []; %>
      <div class="form-grid">
        <div>
          <label for="name">Name</label>
          <input id="name" name="name" type="text" value="<%= player.name %>" required />
        </div>
        <div>
          <label for="username">Username</label>
          <input id="username" name="username" type="text" value="<%= player.username %>" required />
        </div>
        <div>
          <label for="email">Email</label>
          <input id="email" name="email" type="email" value="<%= player.email %>" required />
        </div>
        <div>
          <label for="age">Age</label>
          <input id="age" name="age" type="number" min="0" value="<%= player.age %>" />
        </div>
        <div>
          <label for="age range">Age Range</label>
          <input id="ageRange" name="ageRange" type="number" min="0" value="<%= player.ageRange %>" />
        </div>
        <div>
          <label for="teamName">Team</label>
          <select id="teamName" name="teamName" required>
            <option value="">Select team</option>
            <% if (player.teamName && !teamList.some(team => team.teamName === player.teamName)) { %>
              <option value="<%= player.teamName %>" selected><%= player.teamName %></option>
            <% } %>
            <% teamList.forEach(team => { %>
              <option value="<%= team.teamName %>" <%= player.teamName === team.teamName ? 'selected' : '' %>><%= team.teamName %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label for="role">Role</label>
          <select id="role" name="role" required>
            <option value="">Select Role</option>
            <option value="Jungler" <%= player.role === 'Jungler' ? 'selected' : '' %>>Jungler</option>
            <option value="Mid Laner" <%= player.role === 'Mid Laner' ? 'selected' : '' %>>Mid Laner</option>
            <option value="Exp Laner" <%= player.role === 'Exp Laner' ? 'selected' : '' %>>Exp Laner</option>
            <option value="Gold Laner" <%= player.role === 'Gold Laner' ? 'selected' : '' %>>Gold Laner</option>
            <option value="Roamer" <%= player.role === 'Roamer' ? 'selected' : '' %>>Roamer</option>
            <option value="Substitute" <%= player.role === 'Substitute' ? 'selected' : '' %>>Substitute</option>
            <option value="Coach" <%= player.role === 'Coach' ? 'selected' : '' %>>Coach</option>
            <option value="Analyst" <%= player.role === 'Analyst' ? 'selected' : '' %>>Analyst</option>
          </select>
        </div>
        <div>
          <label for="region">Region</label>
          <select id="region" name="region" required>
            <option value="">Select Singapore region</option>
            <option value="Central" <%= player.region === 'Central' ? 'selected' : '' %>>Central</option>
            <option value="North" <%= player.region === 'North' ? 'selected' : '' %>>North</option>
            <option value="North-East" <%= player.region === 'North-East' ? 'selected' : '' %>>North-East</option>
            <option value="East" <%= player.region === 'East' ? 'selected' : '' %>>East</option>
            <option value="West" <%= player.region === 'West' ? 'selected' : '' %>>West</option>
          </select>
        </div>
